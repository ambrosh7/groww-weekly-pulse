# Local config & secrets (never commit)
config/settings.yaml
.env
.env.*
!.env.example
*.pem
credentials.json
token.json
client_secret*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.envrc

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Bulky or operator-specific raw exports (keep committed fixtures)
data/raw/*
