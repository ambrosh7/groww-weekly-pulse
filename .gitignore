!data/raw/groww_play_reviews_sample.csv

# Generated pipeline artifacts
data/processed/*
!data/processed/.gitkeep
data/output/*
!data/output/.gitkeep

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
